# Copiez ce fichier en .env et remplissez les valeurs.

# Better Auth : secret aléatoire d’au moins 32 caractères (ex. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# URL publique du site, sans barre finale (en production : https://votre-site.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# Application Discord (https://discord.com/developers/applications)
# URL de redirection à déclarer : {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Serveur Discord de l’équipe et rôles autorisés à gérer le contenu
# (identifiants numériques, séparés par des virgules)
DISCORD_GUILD_ID=
DISCORD_TEAM_ROLES=

# Identifiants Discord (utilisateurs) qui ont toujours accès à la gestion, même sans rôle
# (séparés par des virgules)
DISCORD_ADMIN_IDS=

# ——— Production (Vercel) ———
# Vides en local : la base est alors data/saint-eresia.db et les images vont dans data/uploads/.

# Base Turso (https://turso.tech) : `turso db show --url` et `turso db tokens create <nom>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob : jeton du store (onglet Storage du projet Vercel)
BLOB_READ_WRITE_TOKEN=
